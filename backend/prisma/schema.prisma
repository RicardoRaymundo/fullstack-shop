datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

model Product {
    id          String   @id @default(uuid())
    name        String
    description String?
    price       Float
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}